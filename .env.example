# ─── Night Crawlers API — every setting the server reads ─────────────────────
# Copy to .env and fill in. NEVER commit .env or share it.

NODE_ENV=production            # development locally
PORT=5000
MONGODB_URI=
JWT_SECRET=                    # long random string; changing it logs everyone out
ADMIN_SESSION_HOURS=8          # admins are signed out after this many hours (and when the browser closes)

# Frontends allowed to call the API from a browser (comma-separated)
FRONTEND_URL=https://night-crawlers.vercel.app
CORS_ORIGINS=                  # extra origins, e.g. https://nightcrawlers.app
CORS_ALLOW_VERCEL_PREVIEWS=false
PUBLIC_API_URL=https://api.nightcrawlers.app   # used in email links

# ─── Email (Hostinger SMTP) — USER and FROM must be the same mailbox ─────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_INBOX=                 # where contact-form messages go (defaults to SMTP_FROM)

# ─── SMS ─────────────────────────────────────────────────────────────────────
SMS_PROVIDER=sendchamp         # or: termii
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_NAME=Sendchamp
SENDCHAMP_ROUTE=dnd
TERMII_API_KEY=
TERMII_SENDER_ID=              # must be approved for the DND route to deliver OTPs
TERMII_BASE_URL=               # shown on your Termii dashboard
TERMII_CHANNEL=dnd
# Temporary launch switch: set to false to allow orders/approvals without a
# verified phone while SMS delivery is being fixed. Remove once SMS works.
REQUIRE_PHONE_VERIFICATION=true

# ─── Money ───────────────────────────────────────────────────────────────────
# Delivery is priced by distance (store → customer, estimated road km):
#   fee = BASE + PER_KM × (km beyond INCLUDED_KM), rounded up to ₦50, kept between MIN and MAX
DELIVERY_BASE_FEE=500
DELIVERY_PER_KM=150
DELIVERY_INCLUDED_KM=2
DELIVERY_MIN_FEE=500
DELIVERY_MAX_FEE=3000
DELIVERY_MAX_KM=20             # further than this is refused
DELIVERY_ROAD_FACTOR=1.3       # straight-line km × this ≈ road km
DELIVERY_FEE=800               # fallback only, when a location is unknown
SERVICE_FEE_PERCENT=5

# ─── Delivery time estimates (minutes) — optional, defaults shown ───────────
ETA_PREP_FOOD=20
ETA_PREP_GROCERIES=15
ETA_PREP_PHARMACY=10
ETA_PREP_DRINKS=10
ETA_PREP_LOUNGES=15
ETA_CONFIRM_MINUTES=5          # store accepts the order
ETA_DISPATCH_MINUTES=5         # a rider accepts once it's ready
ETA_RIDER_TO_STORE_MINUTES=8
ETA_RIDE_SPEED_KMH=25          # average night-time riding speed
ETA_WINDOW_MINUTES=15          # width of the window shown ("11:40–11:55 PM")

# ─── Live rider trips (road routes) ─────────────────────────────────────────
# osrm (default, free public DEMO server — testing only), ors, or mapbox
ROUTING_PROVIDER=osrm
OSRM_URL=                      # your own OSRM server, if you run one
OPENROUTESERVICE_API_KEY=      # for ROUTING_PROVIDER=ors
MAPBOX_TOKEN=                  # for ROUTING_PROVIDER=mapbox
ROUTE_TIME_FACTOR=1            # e.g. 0.8 if bikes are ~20% faster than car times
ARRIVAL_RADIUS_METERS=150      # how close a rider must be to mark "delivered"
PAYSTACK_API_KEY=              # SECRET key. sk_test_… = test mode, sk_live_… = real money

# ─── Identity checks ─────────────────────────────────────────────────────────
PREMBLY_API_KEY=
PREMBLY_APP_ID=
SMILEID_PARTNER_ID=
SMILEID_API_KEY=
SMILEID_ENVIRONMENT=

# ─── Maps / geocoding (optional) ─────────────────────────────────────────────
GEOCODER_COUNTRY=ng
GEOCODER_USER_AGENT=           # defaults to "NightCrawlers/1.0 (<SMTP_FROM>)"

# ─── Loyalty: points, delivery credit, referrals (optional) ─────────────────
# All have sensible defaults; see utils/rewards.js.
POINTS_PER_100_NAIRA=1                  # points earned per ₦100 of food, on delivery
POINTS_REDEEM_BLOCK=100                 # points needed per redemption...
POINTS_REDEEM_VALUE=500                 # ...worth this much ₦ of delivery credit
REFERRAL_REWARD=free_delivery           # what the referrer gets: free_delivery | credit
REFERRAL_CREDIT_AMOUNT=5000             # ₦ delivery credit, when REFERRAL_REWARD=credit
REFERRAL_NEW_USER_FREE_DELIVERIES=1     # free deliveries a friend gets for joining with a code

# ─── Order timers (optional; see utils/orderTimers.js) ──────────────────────
ORDER_TIMERS_ENABLED=true            # false turns every timer off
ORDER_TIMER_SMS=true                 # SMS reminders/warnings/cancellations (costs SMS credit)
ORDER_TIMER_INTERVAL_SECONDS=60      # how often overdue orders are checked
PAYMENT_TIMEOUT_MINUTES=30           # unpaid online orders are cancelled after this
VENDOR_REMIND_MINUTES=5              # SMS the store if not accepted after this
VENDOR_ACCEPT_TIMEOUT_MINUTES=10     # cancel (and refund) if not accepted after this
RIDER_PICKUP_BUFFER_MINUTES=10       # added to the rider's ride time to the store
RIDER_PICKUP_MIN_MINUTES=15          # pick-up deadline is never shorter than this...
RIDER_PICKUP_MAX_MINUTES=45          # ...or longer than this
